{
  "name": "dsh-version-update",
  "version": "1.4.1",
  "description": "版本与更新：在设置页显示 dsh 版本与环境信息，按 dist-tag 全量解析官方正式版与 Alpha 预览版并生成各自的升级提示词（dsh-version-update）。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./version": "./lib/version.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node test/version.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-ui",
    "version",
    "update",
    "alpha",
    "plugin"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "locale",
    "test",
    "icon.svg",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ]
}
