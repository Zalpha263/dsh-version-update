{
  "name": "dsh-version-update",
  "version": "2.0.0",
  "description": "更新日志：按 Alpha 预览版与 RC 稳定版分组、可折叠地浏览 dsh 官方版本变更（新增/优化/修复/其他），支持全文搜索、本机版本定位、版本区间对比与离线缓存。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "test": "node test/changelog.test.mjs && node test/client-smoke.test.mjs"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-ui",
    "changelog",
    "release-notes",
    "version",
    "alpha",
    "rc",
    "plugin"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "locale",
    "test",
    "icon.svg",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ]
}
